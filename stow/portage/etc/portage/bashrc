if [[ "${EBUILD_PHASE}" == "setup" ]]; then
    case "${CATEGORY}/${PN}" in
        llvm-core/*|llvm-runtimes/*)
            return
            ;;
    esac

    _use_polly=0
    if [[ -f /etc/portage/package.env ]]; then
        if grep -qE "^${CATEGORY}/${PN}[[:space:]]+(zen3-extreme|zen3-extreme-noltostrip)([[:space:]]|$)" /etc/portage/package.env 2>/dev/null; then
            _use_polly=1
        fi
    fi

    if [[ ${_use_polly} -eq 1 ]]; then
        for slot in 22 21 20 19; do
            if [[ -f "/usr/lib/llvm/${slot}/lib64/LLVMPolly.so" ]]; then
                export CFLAGS="${CFLAGS} -fpass-plugin=/usr/lib/llvm/${slot}/lib64/LLVMPolly.so"
                export CXXFLAGS="${CXXFLAGS} -fpass-plugin=/usr/lib/llvm/${slot}/lib64/LLVMPolly.so"
                break
            fi
        done
    fi
fi
