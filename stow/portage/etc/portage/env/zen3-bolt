# /etc/portage/env/zen3-bolt
# Optimized for Zen 3 + Relocations for BOLT optimization
COMMON_FLAGS="-O3 -march=znver3 -mtune=znver3 -pipe -fno-semantic-interposition"
CFLAGS="${COMMON_FLAGS} -flto=thin"
CXXFLAGS="${COMMON_FLAGS} -flto=thin"

# -Wl,-q is the essential flag to keep the binary "readable" for BOLT
LDFLAGS="${LDFLAGS} -fuse-ld=lld -Wl,-q"
