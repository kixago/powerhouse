# /etc/portage/env/firefox-opt
# Let Firefox handle most of the optimization itself
COMMON_FLAGS="-O2 -march=znver3 -mtune=znver3 -pipe"
CFLAGS="${COMMON_FLAGS}"
CXXFLAGS="${COMMON_FLAGS}"

# Don't override LTO - Firefox manages this internally for PGO
LDFLAGS="-Wl,--as-needed"

# Use znver3 explicitly, not native
export RUSTFLAGS="-C opt-level=3 -C target-cpu=znver3"
