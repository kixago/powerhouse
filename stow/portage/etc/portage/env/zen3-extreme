COMMON_FLAGS="-march=znver3 -mtune=znver3 -O3 -pipe \
  -fno-semantic-interposition -fno-plt \
  -fvectorize -fslp-vectorize \
  -fomit-frame-pointer"
CFLAGS="${COMMON_FLAGS} -flto=thin"
CXXFLAGS="${COMMON_FLAGS} -flto=thin"
LDFLAGS="-fuse-ld=lld -Wl,--as-needed -Wl,--gc-sections -Wl,-O2 \
  -Wl,--thinlto-cache-dir=/var/tmp/portage/thinlto_cache \
  -Wl,--thinlto-cache-policy=cache_size_bytes=5g"
